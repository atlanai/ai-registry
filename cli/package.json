{
  "name": "@atlanai/aireg",
  "version": "0.1.8",
  "private": true,
  "description": "Install agent artifacts from any registry into any coding agent.",
  "keywords": [
    "agent",
    "skills",
    "registry",
    "claude-code",
    "codex",
    "cursor"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atlanai/ai-registry.git",
    "directory": "cli"
  },
  "homepage": "https://atlanai.github.io/ai-registry/",
  "bugs": {
    "url": "https://github.com/atlanai/ai-registry/issues"
  },
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "bin": {
    "aireg": "bin/aireg.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/adapter.mjs"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#package.json": "./package.json",
    "#adapter/*": "./src/adapter/*",
    "#adapters/*": "./src/adapters/*",
    "#accounts/*": "./src/accounts/*",
    "#cli/*": "./src/cli/*",
    "#core/*": "./src/core/*",
    "#daemon/*": "./src/daemon/*",
    "#engine/*": "./src/engine/*",
    "#targets/*": "./src/targets/*",
    "#self/*": "./src/self/*",
    "#schema/*": "./schema/*",
    "#scripts/*": "./scripts/*",
    "#packaging/*": "./packaging/*",
    "#test/*": "./test/*"
  },
  "files": [
    "bin",
    "dist",
    "schema",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "scripts": {
    "dev": "node --experimental-strip-types --no-warnings src/main.ts",
    "build": "tsup && tsc -p tsconfig.types.json",
    "typecheck": "tsc -b --force",
    "lint": "biome check .",
    "lint:ci": "biome ci .",
    "lint:changed": "biome ci --changed --error-on-warnings --no-errors-on-unmatched .",
    "fix": "biome lint --only=correctness/noUnusedImports --write --unsafe . && biome check --write .",
    "knip": "knip",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:contract": "vitest run --project contract",
    "test:conformance": "vitest run --project conformance",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --project unit --project integration --project contract",
    "schema": "node --experimental-strip-types scripts/schema/generate.ts",
    "notices": "node --experimental-strip-types scripts/notices/generate.ts",
    "check:package": "publint --strict",
    "release:compile": "node --experimental-strip-types packaging/main.ts compile",
    "verify": "pnpm run typecheck && pnpm run lint:ci && pnpm run knip && pnpm run notices --check && pnpm run build && pnpm run check:package && pnpm run test"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ink": "8.0.0",
    "re2js": "2.9.0",
    "react": "19.3.1",
    "string-width": "8.3.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@sinclair/typebox": "0.34.52",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "knip": "6.43.0",
    "publint": "0.3.25",
    "tsup": "9.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
