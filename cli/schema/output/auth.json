{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "output/auth.json",
  "title": "aireg auth --json",
  "description": "The `data` each `aireg auth` action prints under --json, by action.",
  "$defs": {
    "list": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "accounts"
      ],
      "properties": {
        "accounts": {
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "id",
              "registry",
              "signedIn",
              "needsSignIn"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "registry": {
                "description": "The registry's name in your manifests.",
                "type": "string"
              },
              "defaultNamespace": {
                "type": "string"
              },
              "signedIn": {
                "type": "boolean"
              },
              "needsSignIn": {
                "description": "False for a registry aireg does not sign in to, such as a folder or git.",
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "login": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "account"
      ],
      "properties": {
        "account": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "id",
            "registry"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "registry": {
              "description": "The registry's name in your manifests.",
              "type": "string"
            },
            "defaultNamespace": {
              "type": "string"
            }
          }
        },
        "identity": {
          "additionalProperties": false,
          "description": "Who the registry says signed in, when it says.",
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "account": {
              "type": "string"
            }
          }
        }
      }
    },
    "logout": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "accountId"
      ],
      "properties": {
        "accountId": {
          "type": "string"
        }
      }
    },
    "remove": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "accountId"
      ],
      "properties": {
        "accountId": {
          "type": "string"
        }
      }
    }
  }
}
