{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "output/sync.json",
  "title": "aireg sync --json",
  "description": "The `data` each `aireg sync` action prints under --json, by action.",
  "$defs": {
    "sync": {
      "anyOf": [
        {
          "additionalProperties": false,
          "description": "Under --dry-run.",
          "type": "object",
          "required": [
            "dryRun",
            "scope",
            "artifacts",
            "local",
            "undeclared",
            "linkable",
            "changed",
            "kept"
          ],
          "properties": {
            "dryRun": {
              "const": true,
              "type": "boolean"
            },
            "scope": {
              "anyOf": [
                {
                  "const": "user",
                  "type": "string"
                },
                {
                  "const": "project",
                  "type": "string"
                }
              ]
            },
            "artifacts": {
              "type": "array",
              "items": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "name",
                  "kind",
                  "path",
                  "disposition",
                  "digests",
                  "registry"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "kind": {
                    "anyOf": [
                      {
                        "const": "plugin",
                        "type": "string"
                      },
                      {
                        "const": "skill",
                        "type": "string"
                      },
                      {
                        "const": "agent",
                        "type": "string"
                      }
                    ]
                  },
                  "path": {
                    "description": "Its address in the registry.",
                    "type": "string"
                  },
                  "disposition": {
                    "anyOf": [
                      {
                        "const": "synced",
                        "type": "string"
                      },
                      {
                        "const": "pull",
                        "type": "string"
                      },
                      {
                        "const": "pull-delete",
                        "type": "string"
                      },
                      {
                        "const": "publish",
                        "type": "string"
                      },
                      {
                        "const": "conflict",
                        "type": "string"
                      },
                      {
                        "const": "adopt",
                        "type": "string"
                      },
                      {
                        "const": "archive",
                        "type": "string"
                      },
                      {
                        "const": "removed",
                        "type": "string"
                      },
                      {
                        "const": "unknown",
                        "type": "string"
                      },
                      {
                        "const": "unavailable",
                        "type": "string"
                      }
                    ]
                  },
                  "digests": {
                    "additionalProperties": false,
                    "description": "A side with no bytes has no digest.",
                    "type": "object",
                    "properties": {
                      "base": {
                        "type": "string"
                      },
                      "local": {
                        "type": "string"
                      },
                      "upstream": {
                        "type": "string"
                      }
                    }
                  },
                  "detail": {
                    "type": "string"
                  },
                  "failure": {
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "code",
                      "retryable"
                    ],
                    "properties": {
                      "code": {
                        "type": "string"
                      },
                      "retryable": {
                        "type": "boolean"
                      }
                    }
                  },
                  "registry": {
                    "type": "string"
                  }
                }
              }
            },
            "local": {
              "type": "array",
              "items": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "name",
                  "kind",
                  "path",
                  "target",
                  "suggestedPath"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "kind": {
                    "anyOf": [
                      {
                        "const": "plugin",
                        "type": "string"
                      },
                      {
                        "const": "skill",
                        "type": "string"
                      },
                      {
                        "const": "agent",
                        "type": "string"
                      }
                    ]
                  },
                  "path": {
                    "description": "Its folder, relative to the scope.",
                    "type": "string"
                  },
                  "target": {
                    "type": "string"
                  },
                  "suggestedPath": {
                    "type": "string"
                  }
                }
              }
            },
            "undeclared": {
              "type": "array",
              "items": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "name",
                  "kind",
                  "path",
                  "target"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "kind": {
                    "anyOf": [
                      {
                        "const": "plugin",
                        "type": "string"
                      },
                      {
                        "const": "skill",
                        "type": "string"
                      },
                      {
                        "const": "agent",
                        "type": "string"
                      }
                    ]
                  },
                  "path": {
                    "description": "Its folder, relative to the scope.",
                    "type": "string"
                  },
                  "target": {
                    "type": "string"
                  }
                }
              }
            },
            "linkable": {
              "type": "array",
              "items": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "name",
                  "kind",
                  "path",
                  "target"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "kind": {
                    "anyOf": [
                      {
                        "const": "plugin",
                        "type": "string"
                      },
                      {
                        "const": "skill",
                        "type": "string"
                      },
                      {
                        "const": "agent",
                        "type": "string"
                      }
                    ]
                  },
                  "path": {
                    "description": "Its folder, relative to the scope.",
                    "type": "string"
                  },
                  "target": {
                    "type": "string"
                  }
                }
              }
            },
            "changed": {
              "type": "array",
              "items": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "name",
                  "kind",
                  "path",
                  "target"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "kind": {
                    "anyOf": [
                      {
                        "const": "plugin",
                        "type": "string"
                      },
                      {
                        "const": "skill",
                        "type": "string"
                      },
                      {
                        "const": "agent",
                        "type": "string"
                      }
                    ]
                  },
                  "path": {
                    "description": "Its folder, relative to the scope.",
                    "type": "string"
                  },
                  "target": {
                    "type": "string"
                  }
                }
              }
            },
            "kept": {
              "type": "array",
              "items": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "name",
                  "kind",
                  "path",
                  "target"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "kind": {
                    "anyOf": [
                      {
                        "const": "plugin",
                        "type": "string"
                      },
                      {
                        "const": "skill",
                        "type": "string"
                      },
                      {
                        "const": "agent",
                        "type": "string"
                      }
                    ]
                  },
                  "path": {
                    "description": "Its folder, relative to the scope.",
                    "type": "string"
                  },
                  "target": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "additionalProperties": false,
          "description": "Without --dry-run, a run per registry.",
          "type": "object",
          "required": [
            "dryRun",
            "scope",
            "runs"
          ],
          "properties": {
            "dryRun": {
              "const": false,
              "type": "boolean"
            },
            "scope": {
              "anyOf": [
                {
                  "const": "user",
                  "type": "string"
                },
                {
                  "const": "project",
                  "type": "string"
                }
              ]
            },
            "runs": {
              "type": "array",
              "items": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "registry",
                  "id",
                  "state",
                  "counts",
                  "artifacts",
                  "warnings"
                ],
                "properties": {
                  "registry": {
                    "type": "string"
                  },
                  "id": {
                    "type": "string"
                  },
                  "state": {
                    "anyOf": [
                      {
                        "const": "queued",
                        "type": "string"
                      },
                      {
                        "const": "running",
                        "type": "string"
                      },
                      {
                        "const": "succeeded",
                        "type": "string"
                      },
                      {
                        "const": "attention",
                        "type": "string"
                      },
                      {
                        "const": "partial",
                        "type": "string"
                      },
                      {
                        "const": "failed",
                        "type": "string"
                      },
                      {
                        "const": "timed_out",
                        "type": "string"
                      },
                      {
                        "const": "canceled",
                        "type": "string"
                      },
                      {
                        "const": "abandoned",
                        "type": "string"
                      }
                    ]
                  },
                  "counts": {
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "examined",
                      "changed",
                      "skipped",
                      "attention",
                      "failed"
                    ],
                    "properties": {
                      "examined": {
                        "type": "number"
                      },
                      "changed": {
                        "type": "number"
                      },
                      "skipped": {
                        "type": "number"
                      },
                      "attention": {
                        "type": "number"
                      },
                      "failed": {
                        "type": "number"
                      }
                    }
                  },
                  "artifacts": {
                    "type": "array",
                    "items": {
                      "additionalProperties": false,
                      "type": "object",
                      "required": [
                        "name",
                        "outcome"
                      ],
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "kind": {
                          "anyOf": [
                            {
                              "const": "plugin",
                              "type": "string"
                            },
                            {
                              "const": "skill",
                              "type": "string"
                            },
                            {
                              "const": "agent",
                              "type": "string"
                            }
                          ]
                        },
                        "outcome": {
                          "anyOf": [
                            {
                              "const": "changed",
                              "type": "string"
                            },
                            {
                              "const": "unchanged",
                              "type": "string"
                            },
                            {
                              "const": "skipped",
                              "type": "string"
                            },
                            {
                              "const": "attention",
                              "type": "string"
                            },
                            {
                              "const": "failed",
                              "type": "string"
                            }
                          ]
                        },
                        "operation": {
                          "anyOf": [
                            {
                              "const": "none",
                              "type": "string"
                            },
                            {
                              "const": "pull",
                              "type": "string"
                            },
                            {
                              "const": "remove-local",
                              "type": "string"
                            },
                            {
                              "const": "publish",
                              "type": "string"
                            },
                            {
                              "const": "archive",
                              "type": "string"
                            },
                            {
                              "const": "forget",
                              "type": "string"
                            },
                            {
                              "const": "attention",
                              "type": "string"
                            },
                            {
                              "const": "report",
                              "type": "string"
                            },
                            {
                              "const": "ignore",
                              "type": "string"
                            }
                          ]
                        },
                        "disposition": {
                          "anyOf": [
                            {
                              "const": "synced",
                              "type": "string"
                            },
                            {
                              "const": "pull",
                              "type": "string"
                            },
                            {
                              "const": "pull-delete",
                              "type": "string"
                            },
                            {
                              "const": "publish",
                              "type": "string"
                            },
                            {
                              "const": "conflict",
                              "type": "string"
                            },
                            {
                              "const": "adopt",
                              "type": "string"
                            },
                            {
                              "const": "archive",
                              "type": "string"
                            },
                            {
                              "const": "removed",
                              "type": "string"
                            },
                            {
                              "const": "unknown",
                              "type": "string"
                            },
                            {
                              "const": "unavailable",
                              "type": "string"
                            }
                          ]
                        }
                      }
                    }
                  },
                  "warnings": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "resolve": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "run",
        "artifacts"
      ],
      "properties": {
        "run": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "id",
            "accountId",
            "configRevision",
            "mode",
            "trigger",
            "state",
            "requestedAtMs",
            "deadlineAtMs",
            "counts",
            "retryable"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "jobId": {
              "description": "Absent for a run no job started.",
              "type": "string"
            },
            "accountId": {
              "type": "string"
            },
            "configRevision": {
              "type": "number"
            },
            "mode": {
              "anyOf": [
                {
                  "const": "sync",
                  "type": "string"
                },
                {
                  "const": "pull",
                  "type": "string"
                },
                {
                  "const": "publish",
                  "type": "string"
                }
              ]
            },
            "trigger": {
              "anyOf": [
                {
                  "const": "manual",
                  "type": "string"
                },
                {
                  "const": "schedule",
                  "type": "string"
                },
                {
                  "const": "startup",
                  "type": "string"
                }
              ]
            },
            "state": {
              "anyOf": [
                {
                  "const": "queued",
                  "type": "string"
                },
                {
                  "const": "running",
                  "type": "string"
                },
                {
                  "const": "succeeded",
                  "type": "string"
                },
                {
                  "const": "attention",
                  "type": "string"
                },
                {
                  "const": "partial",
                  "type": "string"
                },
                {
                  "const": "failed",
                  "type": "string"
                },
                {
                  "const": "timed_out",
                  "type": "string"
                },
                {
                  "const": "canceled",
                  "type": "string"
                },
                {
                  "const": "abandoned",
                  "type": "string"
                }
              ]
            },
            "step": {
              "type": "string"
            },
            "requestedAtMs": {
              "description": "Milliseconds since the Unix epoch.",
              "type": "number"
            },
            "startedAtMs": {
              "description": "Milliseconds since the Unix epoch.",
              "type": "number"
            },
            "deadlineAtMs": {
              "description": "Milliseconds since the Unix epoch.",
              "type": "number"
            },
            "finishedAtMs": {
              "description": "Milliseconds since the Unix epoch.",
              "type": "number"
            },
            "counts": {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "examined",
                "changed",
                "skipped",
                "attention",
                "failed"
              ],
              "properties": {
                "examined": {
                  "type": "number"
                },
                "changed": {
                  "type": "number"
                },
                "skipped": {
                  "type": "number"
                },
                "attention": {
                  "type": "number"
                },
                "failed": {
                  "type": "number"
                }
              }
            },
            "errorCode": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            }
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "name",
              "outcome"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "kind": {
                "anyOf": [
                  {
                    "const": "plugin",
                    "type": "string"
                  },
                  {
                    "const": "skill",
                    "type": "string"
                  },
                  {
                    "const": "agent",
                    "type": "string"
                  }
                ]
              },
              "outcome": {
                "anyOf": [
                  {
                    "const": "changed",
                    "type": "string"
                  },
                  {
                    "const": "unchanged",
                    "type": "string"
                  },
                  {
                    "const": "skipped",
                    "type": "string"
                  },
                  {
                    "const": "attention",
                    "type": "string"
                  },
                  {
                    "const": "failed",
                    "type": "string"
                  }
                ]
              },
              "operation": {
                "anyOf": [
                  {
                    "const": "none",
                    "type": "string"
                  },
                  {
                    "const": "pull",
                    "type": "string"
                  },
                  {
                    "const": "remove-local",
                    "type": "string"
                  },
                  {
                    "const": "publish",
                    "type": "string"
                  },
                  {
                    "const": "archive",
                    "type": "string"
                  },
                  {
                    "const": "forget",
                    "type": "string"
                  },
                  {
                    "const": "attention",
                    "type": "string"
                  },
                  {
                    "const": "report",
                    "type": "string"
                  },
                  {
                    "const": "ignore",
                    "type": "string"
                  }
                ]
              },
              "disposition": {
                "anyOf": [
                  {
                    "const": "synced",
                    "type": "string"
                  },
                  {
                    "const": "pull",
                    "type": "string"
                  },
                  {
                    "const": "pull-delete",
                    "type": "string"
                  },
                  {
                    "const": "publish",
                    "type": "string"
                  },
                  {
                    "const": "conflict",
                    "type": "string"
                  },
                  {
                    "const": "adopt",
                    "type": "string"
                  },
                  {
                    "const": "archive",
                    "type": "string"
                  },
                  {
                    "const": "removed",
                    "type": "string"
                  },
                  {
                    "const": "unknown",
                    "type": "string"
                  },
                  {
                    "const": "unavailable",
                    "type": "string"
                  }
                ]
              }
            }
          }
        }
      }
    }
  }
}
