{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "output/show.json",
  "title": "aireg show --json",
  "description": "The `data` each `aireg show` action prints under --json, by action.",
  "$defs": {
    "show": {
      "anyOf": [
        {
          "additionalProperties": false,
          "description": "An artifact a registry serves.",
          "type": "object",
          "required": [
            "name",
            "kind",
            "body",
            "carries"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "kind": {
              "anyOf": [
                {
                  "const": "plugin",
                  "type": "string"
                },
                {
                  "const": "skill",
                  "type": "string"
                },
                {
                  "const": "agent",
                  "type": "string"
                },
                {
                  "const": "semantic_model",
                  "type": "string"
                },
                {
                  "const": "mcp_server",
                  "type": "string"
                }
              ]
            },
            "version": {
              "description": "The version the registry serves.",
              "type": "string"
            },
            "body": {
              "description": "The Markdown file as written.",
              "type": "string"
            },
            "carries": {
              "description": "What a target that loads it starts on its own, by plugin manifest key.",
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "const": "hooks",
                    "type": "string"
                  },
                  {
                    "const": "mcpServers",
                    "type": "string"
                  },
                  {
                    "const": "lspServers",
                    "type": "string"
                  },
                  {
                    "const": "monitors",
                    "type": "string"
                  },
                  {
                    "const": "bin",
                    "type": "string"
                  }
                ]
              }
            },
            "server": {
              "additionalProperties": false,
              "description": "For an MCP server.",
              "type": "object",
              "required": [
                "runs",
                "reads",
                "leftOut"
              ],
              "properties": {
                "runs": {
                  "description": "Each way it runs: a command line, or a URL.",
                  "type": "array",
                  "items": {
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "transport"
                    ],
                    "properties": {
                      "transport": {
                        "type": "string"
                      },
                      "command": {
                        "type": "string"
                      },
                      "url": {
                        "type": "string"
                      }
                    }
                  }
                },
                "reads": {
                  "description": "Environment variables it reads its secrets from.",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "leftOut": {
                  "description": "Why a way it lists cannot run.",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "additionalProperties": false,
          "description": "A file or folder named by its path.",
          "type": "object",
          "required": [
            "path",
            "body",
            "carries"
          ],
          "properties": {
            "path": {
              "description": "The Markdown file read.",
              "type": "string"
            },
            "body": {
              "description": "The file as written.",
              "type": "string"
            },
            "carries": {
              "description": "What a target that loads it starts on its own, by plugin manifest key.",
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "const": "hooks",
                    "type": "string"
                  },
                  {
                    "const": "mcpServers",
                    "type": "string"
                  },
                  {
                    "const": "lspServers",
                    "type": "string"
                  },
                  {
                    "const": "monitors",
                    "type": "string"
                  },
                  {
                    "const": "bin",
                    "type": "string"
                  }
                ]
              }
            }
          }
        }
      ]
    }
  }
}
