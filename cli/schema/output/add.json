{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "output/add.json",
  "title": "aireg add --json",
  "description": "The `data` each `aireg add` action prints under --json, by action.",
  "$defs": {
    "add": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "registry",
        "artifacts",
        "dependencies",
        "dryRun",
        "changed",
        "installed",
        "kept"
      ],
      "properties": {
        "registry": {
          "type": "string"
        },
        "artifacts": {
          "description": "The full names added to the manifest.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "layout": {
          "description": "Present for a source that is not a registry.",
          "anyOf": [
            {
              "const": "registry",
              "type": "string"
            },
            {
              "const": "marketplace",
              "type": "string"
            },
            {
              "const": "well-known",
              "type": "string"
            },
            {
              "const": "folder",
              "type": "string"
            }
          ]
        },
        "dependencies": {
          "description": "Each artifact installed only because others depend on it, to their names.",
          "type": "object",
          "patternProperties": {
            "^(.*)$": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "dryRun": {
          "type": "boolean"
        },
        "changed": {
          "description": "The changes made; for a dry run, the changes it would make.",
          "type": "number"
        },
        "installed": {
          "description": "The artifacts linked into a target.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kept": {
          "description": "Links not made because something of the person's is already there; empty for a dry run.",
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "name",
              "path"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "config": {
                "const": true,
                "type": "boolean"
              }
            }
          }
        },
        "renamed": {
          "description": "Installed under another name because its own is taken.",
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "artifact",
              "as",
              "by"
            ],
            "properties": {
              "artifact": {
                "type": "string"
              },
              "as": {
                "type": "string"
              },
              "by": {
                "type": "string"
              }
            }
          }
        },
        "unlinked": {
          "description": "Not installed because its name is taken.",
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "artifact",
              "by"
            ],
            "properties": {
              "artifact": {
                "type": "string"
              },
              "by": {
                "type": "string"
              },
              "at": {
                "type": "string"
              }
            }
          }
        },
        "jobId": {
          "description": "The background job that keeps a user scope install current.",
          "type": "string"
        }
      }
    }
  }
}
