{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "output/config.json",
  "title": "aireg config --json",
  "description": "The `data` each `aireg config` action prints under --json, by action.",
  "$defs": {
    "list": {
      "type": "object",
      "patternProperties": {
        "^(.*)$": {
          "description": "`null` when the setting is not set.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "path": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string"
        }
      }
    },
    "get": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "description": "`null` when the setting is not set.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "set": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "description": "`null` when the setting is not set.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "unset": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "description": "`null` when the setting is not set.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
