{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "target.schema.json",
  "$defs": {
    "kind": {
      "type": "object",
      "required": [
        "shape"
      ],
      "discriminator": {
        "propertyName": "shape"
      },
      "oneOf": [
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "shape"
          ],
          "properties": {
            "shape": {
              "const": "contents",
              "type": "string"
            }
          }
        },
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "shape",
            "subdir"
          ],
          "properties": {
            "shape": {
              "const": "directory",
              "type": "string"
            },
            "subdir": {
              "minLength": 1,
              "type": "string"
            },
            "scope": {
              "description": "Read from the user installation alone.",
              "const": "user",
              "type": "string"
            },
            "place": {
              "type": "string",
              "enum": [
                "link",
                "fan",
                "copy"
              ]
            },
            "entry": {
              "minLength": 1,
              "type": "string"
            },
            "manifest": {
              "type": "array",
              "items": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "path"
                ],
                "properties": {
                  "path": {
                    "minLength": 1,
                    "description": "Relative to the plugin directory.",
                    "type": "string"
                  },
                  "body": {
                    "type": "object",
                    "patternProperties": {
                      "^(.*)$": {
                        "$ref": "#/$defs/value"
                      }
                    }
                  }
                }
              }
            },
            "register": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/register"
              }
            },
            "codec": {
              "$ref": "#/$defs/codec"
            },
            "keys": {
              "description": "Front-matter keys the target does not read as written, for an artifact that sets one.",
              "type": "object",
              "patternProperties": {
                "^(.*)$": {
                  "anyOf": [
                    {
                      "description": "Leave out an artifact that sets the key, rather than drop its limit.",
                      "const": false,
                      "type": "boolean"
                    },
                    {
                      "additionalProperties": false,
                      "type": "object",
                      "required": [
                        "path",
                        "body"
                      ],
                      "properties": {
                        "path": {
                          "pattern": "\\.(json|ya?ml)$",
                          "description": "Relative to the artifact's folder.",
                          "type": "string"
                        },
                        "body": {
                          "type": "object",
                          "patternProperties": {
                            "^(.*)$": {
                              "$ref": "#/$defs/value"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "shape",
            "subdir",
            "extension"
          ],
          "properties": {
            "shape": {
              "const": "file",
              "type": "string"
            },
            "subdir": {
              "minLength": 1,
              "type": "string"
            },
            "extension": {
              "pattern": "^\\.[A-Za-z0-9.]+$",
              "type": "string"
            },
            "scope": {
              "description": "Read from the user installation alone.",
              "const": "user",
              "type": "string"
            },
            "place": {
              "type": "string",
              "enum": [
                "link",
                "copy"
              ]
            },
            "codec": {
              "$ref": "#/$defs/codec"
            },
            "render": {
              "additionalProperties": false,
              "description": "Deprecated: use the frontmatter-toml codec.",
              "type": "object",
              "required": [
                "format",
                "fields",
                "body"
              ],
              "properties": {
                "format": {
                  "const": "toml",
                  "type": "string"
                },
                "fields": {
                  "type": "array",
                  "items": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "body": {
                  "minLength": 1,
                  "type": "string"
                }
              }
            }
          }
        }
      ],
      "description": "Where one kind lands inside the target's folder."
    },
    "register": {
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "value"
          ]
        },
        {
          "required": [
            "upsert"
          ]
        },
        {
          "required": [
            "append"
          ]
        }
      ],
      "description": "One edit to a config file the target reads: `value`, `upsert` or `append`.",
      "type": "object",
      "required": [
        "file",
        "format",
        "at"
      ],
      "properties": {
        "file": {
          "minLength": 1,
          "description": "Relative to the target root.",
          "type": "string"
        },
        "format": {
          "type": "string",
          "enum": [
            "toml",
            "json",
            "yaml"
          ]
        },
        "at": {
          "minItems": 1,
          "description": "Key path to the table this entry writes in.",
          "type": "array",
          "items": {
            "minLength": 1,
            "type": "string"
          }
        },
        "init": {
          "type": "object",
          "patternProperties": {
            "^(.*)$": {
              "$ref": "#/$defs/value"
            }
          }
        },
        "conflict": {
          "type": "string",
          "enum": [
            "overwrite",
            "keep"
          ]
        },
        "remove": {
          "type": "string",
          "enum": [
            "ours",
            "entry"
          ]
        },
        "off": {
          "type": "object",
          "patternProperties": {
            "^(.*)$": {
              "$ref": "#/$defs/value"
            }
          }
        },
        "value": {
          "type": "object",
          "patternProperties": {
            "^(.*)$": {
              "$ref": "#/$defs/value"
            }
          }
        },
        "upsert": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "key",
            "item"
          ],
          "properties": {
            "key": {
              "minLength": 1,
              "type": "string"
            },
            "item": {
              "type": "object",
              "patternProperties": {
                "^(.*)$": {
                  "$ref": "#/$defs/value"
                }
              }
            }
          }
        },
        "append": {
          "minLength": 1,
          "type": "string"
        }
      }
    },
    "codec": {
      "type": "object",
      "required": [
        "id"
      ],
      "discriminator": {
        "propertyName": "id"
      },
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The front-matter fields, each required, and the body under `body`, as TOML.",
          "type": "object",
          "required": [
            "id",
            "fields",
            "body"
          ],
          "properties": {
            "id": {
              "const": "frontmatter-toml",
              "type": "string"
            },
            "fields": {
              "type": "array",
              "items": {
                "minLength": 1,
                "type": "string"
              }
            },
            "body": {
              "minLength": 1,
              "type": "string"
            }
          }
        },
        {
          "additionalProperties": false,
          "description": "Only the front-matter keys in `keep`; dropping a key that limits the agent, or one of `restrictions`, is refused.",
          "type": "object",
          "required": [
            "id",
            "keep"
          ],
          "properties": {
            "id": {
              "const": "frontmatter-strict",
              "type": "string"
            },
            "keep": {
              "type": "array",
              "items": {
                "minLength": 1,
                "type": "string"
              }
            },
            "restrictions": {
              "type": "array",
              "items": {
                "minLength": 1,
                "type": "string"
              }
            }
          }
        },
        {
          "additionalProperties": false,
          "description": "Front-matter keys set to fixed values; changing a key that limits the agent, or one of `restrictions`, is refused.",
          "type": "object",
          "required": [
            "id",
            "set"
          ],
          "properties": {
            "id": {
              "const": "frontmatter-set",
              "type": "string"
            },
            "set": {
              "type": "object",
              "patternProperties": {
                "^(.*)$": {
                  "$ref": "#/$defs/value"
                }
              }
            },
            "restrictions": {
              "type": "array",
              "items": {
                "minLength": 1,
                "type": "string"
              }
            }
          }
        }
      ],
      "description": "A codec aireg builds in, which rewrites the file a target reads in its own format."
    },
    "value": {
      "type": [
        "string",
        "number",
        "boolean",
        "array",
        "object"
      ],
      "description": "Text, a number, true or false, a list or a table; text takes templates."
    }
  },
  "title": "target file",
  "description": "A target aireg installs into, defined in your user scope.",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "id",
    "displayName",
    "roots",
    "kinds"
  ],
  "properties": {
    "$schema": {
      "description": "Ignored by the CLI; lets an editor find this schema.",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9-]{0,63}$",
      "description": "The name `--for` takes.",
      "type": "string"
    },
    "aliases": {
      "description": "Other ids it answers to wherever an id is read, such as an earlier one.",
      "type": "array",
      "items": {
        "pattern": "^[a-z][a-z0-9-]{0,63}$",
        "type": "string"
      }
    },
    "displayName": {
      "minLength": 1,
      "type": "string"
    },
    "overrides": {
      "description": "Replaces the built-in target with this id.",
      "type": "boolean"
    },
    "category": {
      "type": "string",
      "enum": [
        "coding-agent",
        "personal-agent",
        "shared-folder"
      ],
      "description": "Groups targets; `coding-agent` when absent. A `shared-folder` is never detected and never a default."
    },
    "kind": {
      "deprecated": true,
      "description": "The earlier name of `category`: `coding`, `personal` or `shared`; use `category`.",
      "type": "string"
    },
    "roots": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "project",
        "user"
      ],
      "properties": {
        "project": {
          "minLength": 1,
          "description": "Relative to the project.",
          "type": "string"
        },
        "user": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "default"
          ],
          "properties": {
            "default": {
              "pattern": "^~/.",
              "description": "Under your home folder.",
              "type": "string"
            },
            "env": {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "description": "The variable the target itself reads to move it.",
              "type": "string"
            },
            "within": {
              "minLength": 1,
              "description": "The root's path inside the folder `env` names, when not that folder.",
              "type": "string"
            }
          }
        }
      }
    },
    "detect": {
      "anyOf": [
        {
          "const": "never",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "type": "object",
          "properties": {
            "env": {
              "type": "array",
              "items": {
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                "type": "string"
              }
            },
            "binary": {
              "type": "array",
              "items": {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$",
                "type": "string"
              }
            },
            "paths": {
              "type": "array",
              "items": {
                "minLength": 1,
                "type": "string"
              }
            },
            "projectRoot": {
              "description": "Its project folder is one many repositories hold, so proves nothing.",
              "const": false,
              "type": "boolean"
            }
          }
        }
      ]
    },
    "reads": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "plugin": {
          "type": "array",
          "items": {
            "minLength": 1,
            "type": "string"
          }
        },
        "skill": {
          "type": "array",
          "items": {
            "minLength": 1,
            "type": "string"
          }
        },
        "agent": {
          "type": "array",
          "items": {
            "minLength": 1,
            "type": "string"
          }
        }
      }
    },
    "kinds": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "plugin": {
          "$ref": "#/$defs/kind"
        },
        "skill": {
          "$ref": "#/$defs/kind"
        },
        "agent": {
          "$ref": "#/$defs/kind"
        }
      }
    },
    "verified": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "command",
        "range"
      ],
      "properties": {
        "command": {
          "minItems": 1,
          "prefixItems": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$",
              "type": "string"
            }
          ],
          "description": "The program and its arguments, never run through a shell.",
          "type": "array",
          "items": {
            "minLength": 1,
            "type": "string"
          }
        },
        "range": {
          "minLength": 1,
          "type": "string"
        }
      }
    },
    "trust": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "plugin": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "run"
          ],
          "properties": {
            "run": {
              "minLength": 1,
              "description": "Printed, never run.",
              "type": "string"
            },
            "scope": {
              "type": "string",
              "enum": [
                "project",
                "user"
              ]
            }
          }
        },
        "skill": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "run"
          ],
          "properties": {
            "run": {
              "minLength": 1,
              "description": "Printed, never run.",
              "type": "string"
            },
            "scope": {
              "type": "string",
              "enum": [
                "project",
                "user"
              ]
            }
          }
        },
        "agent": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "run"
          ],
          "properties": {
            "run": {
              "minLength": 1,
              "description": "Printed, never run.",
              "type": "string"
            },
            "scope": {
              "type": "string",
              "enum": [
                "project",
                "user"
              ]
            }
          }
        }
      }
    },
    "profiles": {
      "additionalProperties": false,
      "description": "Profiles of one installation, each a target `<id>:<profile>`.",
      "type": "object",
      "required": [
        "root"
      ],
      "properties": {
        "root": {
          "pattern": "^~/.*\\{profile\\}[^/]*$",
          "type": "string"
        }
      }
    },
    "instances": {
      "additionalProperties": false,
      "description": "The earlier name of `profiles`, still read; use `profiles`.",
      "deprecated": true,
      "type": "object",
      "required": [
        "root"
      ],
      "properties": {
        "root": {
          "pattern": "^~/.*\\{profile\\}[^/]*$",
          "type": "string"
        }
      }
    },
    "reload": {
      "minLength": 1,
      "type": "string"
    }
  }
}
