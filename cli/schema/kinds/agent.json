{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kinds/agent.json",
  "title": "agent",
  "description": "An agent definition: an AGENT.md with front-matter, or an A2A agent card (agent-card.json). spec is the parsed front-matter, unchanged, or the card verbatim with its name and description lifted beside it.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "MUST equal metadata.name in the envelope.",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "card": {
      "type": "object",
      "description": "The A2A agent card, verbatim, when the agent ships agent-card.json. Opaque to this manifest."
    }
  },
  "required": [
    "name",
    "description"
  ],
  "additionalProperties": false,
  "x-registry-schema-version": 1,
  "x-registry-searchable": [
    "/name",
    "/description"
  ],
  "x-registry-embeddings": [
    "/description"
  ],
  "x-registry-edges": [
    {
      "rel_type": "depends_on",
      "to_kinds": [
        "skill",
        "agent",
        "mcp_server"
      ],
      "cardinality": "many",
      "direction": "outbound"
    },
    {
      "rel_type": "supersedes",
      "to_kinds": [
        "agent"
      ],
      "cardinality": "one",
      "direction": "outbound"
    }
  ],
  "x-registry-files": {
    "one_of": [
      [
        {
          "path": "AGENT.md",
          "media_type": "text/markdown"
        }
      ],
      [
        {
          "path": "agent-card.json",
          "media_type": "application/json"
        }
      ]
    ]
  },
  "x-registry-attachment": false,
  "x-registry-gated": false
}
