{
  "id": "pi",
  "displayName": "Pi",
  "overrides": true,
  "roots": {
    "project": ".pi",
    "user": { "default": "~/.pi/agent", "env": "PI_CODING_AGENT_DIR" }
  },
  "detect": { "env": ["PI_CODING_AGENT_DIR"], "binary": ["pi"] },
  "reads": { "skill": ["universal", "pi"] },
  "kinds": {
    "plugin": { "shape": "contents" },
    "skill": { "shape": "directory", "subdir": "skills" },
    "mcp_server": {"shape": "config", "file": "mcp.json", "format": "json", "at": ["mcpServers", "{name}"], "codec": {"id": "mcp-json", "secret": {"prefix": "${", "suffix": "}", "in": ["env", "headers"]}}, "transports": ["stdio", "streamable-http"]}
  },
  "verified": { "command": ["pi", "--version"], "range": "1.1.0 || 1.4.0 || 1.5.2" },
  "trust": { "skill": { "run": "/trust", "scope": "project" } },
  "reload": "Run /reload in Pi, or start a new session, to load the change."
}
