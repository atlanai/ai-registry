{
  "id": "opencode",
  "displayName": "OpenCode",
  "overrides": true,
  "roots": {
    "project": ".opencode",
    "user": { "default": "~/.config/opencode", "env": "XDG_CONFIG_HOME", "within": "opencode" }
  },
  "detect": { "env": ["OPENCODE_CONFIG_DIR"], "binary": ["opencode"] },
  "reads": { "skill": ["universal", "opencode", "claude-code"] },
  "kinds": {
    "plugin": { "shape": "contents" },
    "skill": {
      "shape": "directory",
      "subdir": "skills",
      "keys": { "disable-model-invocation": false }
    },
    "agent": {
      "shape": "file",
      "subdir": "agents",
      "extension": ".md",
      "codec": { "id": "frontmatter-strict", "keep": ["description"] }
    },
    "mcp_server": {"shape": "config", "file": "opencode.json", "anchor": "project", "format": "json", "at": ["mcp", "{name}"], "codec": {"id": "mcp-json", "secret": {"prefix": "{env:", "suffix": "}"}, "type": {"stdio": "local", "streamable-http": "remote"}, "command": "array", "env": "environment"}, "transports": ["stdio", "streamable-http"]}
  },
  "verified": { "command": ["opencode", "--version"], "range": "1.17.9 || 1.19.0" }
}
