{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "includes": [
      "src/**/*.ts",
      "test/**/*.ts",
      "test/**/*.mjs",
      "scripts/**/*.ts",
      "packaging/**/*.ts",
      "bin/**/*.mjs",
      "*.ts",
      "*.mjs",
      "*.json",
      "*.jsonc"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "error",
        "noUnusedPrivateClassMembers": "error"
      },
      "suspicious": {
        "noConsole": { "level": "error", "options": { "allow": ["error"] } },
        "noExplicitAny": "error"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "warn",
          "options": { "maxAllowedComplexity": 25 }
        },
        "noExcessiveLinesPerFunction": {
          "level": "warn",
          "options": { "maxLines": 100, "skipBlankLines": true }
        }
      },
      "style": {
        "noExcessiveLinesPerFile": {
          "level": "warn",
          "options": { "maxLines": 1000, "skipBlankLines": true }
        },
        "noNonNullAssertion": "error",
        "noParameterAssign": "warn",
        "useConsistentArrayType": { "level": "error", "options": { "syntax": "shorthand" } },
        "useImportType": "error",
        "useNodejsImportProtocol": "error",
        "useThrowOnlyError": "error"
      },
      "performance": {
        "noDelete": "error"
      },
      "nursery": {
        "noFloatingPromises": "error"
      }
    }
  },
  "assist": {
    "actions": {
      "source": { "organizeImports": "on" }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts", "test/**"],
      "linter": {
        "rules": {
          "complexity": { "noExcessiveLinesPerFunction": "off" },
          "suspicious": { "noConsole": "off" },
          "style": { "noExcessiveLinesPerFile": "off", "noNonNullAssertion": "off" }
        }
      }
    }
  ]
}
