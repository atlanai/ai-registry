{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "include": [
    "files",
    "dependencies",
    "devDependencies",
    "unlisted",
    "binaries",
    "duplicates",
    "exports",
    "types"
  ],
  "project": ["src/**/*.ts", "packaging/**/*.ts", "scripts/**/*.ts", "test/kit/**/*.ts"],
  // util-linux's, which a test runs to give aireg a terminal of its own.
  "ignoreBinaries": ["script"]
}
