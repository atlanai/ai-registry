{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "include": [
    "files",
    "dependencies",
    "devDependencies",
    "unlisted",
    "binaries",
    "duplicates",
    "exports",
    "types"
  ],
  "project": [
    "src/**/*.ts",
    "packaging/**/*.ts",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "ui/**/*.{ts,tsx,css}"
  ],
  // generate.ts imports each command's output schema by reading the folder; vite builds the page
  // from ui/, which imports the UI protocol.
  "entry": [
    "scripts/schema/output/*.ts",
    "src/cli/ui/protocol.ts",
    "ui/src/main.tsx",
    "ui/vite.config.ts"
  ],
  // util-linux's, which a test runs to give aireg a terminal of its own.
  "ignoreBinaries": ["script"]
}
