{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kinds/mcp_server.json",
  "title": "mcp_server",
  "description": "One MCP server, described by the MCP Registry's server.json and stored unchanged. spec contains the registry slug as name, the server's description, and the unchanged server.json in server, which must satisfy the server.json schema its $schema names.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "MUST equal metadata.name in the envelope. The server's own reverse-DNS name stays in server.name.",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "description": {
      "type": "string",
      "description": "A copy of server.description.",
      "minLength": 1,
      "maxLength": 4000
    },
    "server": {
      "type": "object",
      "description": "The MCP Registry server.json, verbatim.",
      "properties": {
        "$schema": {
          "enum": [
            "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json"
          ]
        }
      },
      "required": [
        "$schema"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "$schema": {
                "const": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json"
              }
            },
            "required": [
              "$schema"
            ]
          },
          "then": {
            "$ref": "vendor/mcp/2025-12-11/server.schema.json"
          }
        }
      ]
    }
  },
  "required": [
    "name",
    "description",
    "server"
  ],
  "additionalProperties": false,
  "x-registry-schema-version": 1,
  "x-registry-searchable": [
    "/name",
    "/description",
    "/server/name",
    "/server/title"
  ],
  "x-registry-embeddings": [
    "/description"
  ],
  "x-registry-edges": [
    {
      "rel_type": "supersedes",
      "to_kinds": [
        "mcp_server"
      ],
      "cardinality": "one",
      "direction": "outbound"
    }
  ],
  "x-registry-files": {
    "required": [
      {
        "path": "server.json",
        "media_type": "application/json"
      }
    ],
    "optional": [
      {
        "path": "README.md",
        "media_type": "text/markdown"
      }
    ]
  },
  "x-registry-attachment": false,
  "x-registry-gated": false
}
