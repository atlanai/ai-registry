{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.example/issue-tracker",
  "title": "Issue tracker",
  "description": "Search, read and update issues in the team's issue tracker.",
  "version": "1.2.0",
  "repository": {
    "url": "https://github.com/example/issue-tracker-mcp",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@example/issue-tracker-mcp",
      "version": "1.2.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "ISSUES_URL",
          "description": "Base URL of the issue tracker",
          "isRequired": true
        },
        {
          "name": "ISSUES_TOKEN",
          "description": "API token with read and write scope",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://{tenant}.issues.example.com/mcp",
      "variables": {
        "tenant": {
          "description": "Your tracker workspace",
          "isRequired": true
        }
      },
      "headers": [
        {
          "name": "Authorization",
          "value": "Bearer {token}",
          "variables": {
            "token": {
              "description": "API token with read and write scope",
              "isRequired": true,
              "isSecret": true
            }
          }
        }
      ]
    }
  ]
}
