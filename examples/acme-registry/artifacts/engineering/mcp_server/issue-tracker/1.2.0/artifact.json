    "version": "1.2.0",
    "description": "Search, read and update issues in the team's issue tracker.",
    "display_name": "Issue tracker",
    "digest": "sha256:d05c43b52f0371b731b417c152a2329267f8f27e7390cc6056750d11c9fdc7a0"
  },
  "files": [
    {
      "path": "README.md",
      "digest": "sha256:5f0ad95a640a6cd8d277c51ac069874b0eccf66ce1738c99c95da2b7fe7897d3",
      "size": 361,
      "media_type": "text/markdown",
      "urls": [
        "README.md"
      ]
    },
    {
      "path": "server.json",
      "digest": "sha256:36ad2a03fdbc7579d19a37136a4534cbdb52e68a2fac55d737b17b97622138dd",
      "size": 1504,
      "media_type": "application/json",
      "urls": [
        "server.json"
      ]
    }
  ],
  "spec": {
    "name": "issue-tracker",
    "description": "Search, read and update issues in the team's issue tracker.",
    "server": {
      "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
      "name": "com.example/issue-tracker",
      "title": "Issue tracker",
      "description": "Search, read and update issues in the team's issue tracker.",
      "version": "1.2.0",
      "repository": {
        "url": "https://github.com/example/issue-tracker-mcp",
        "source": "github"
      },
      "packages": [
        {
          "registryType": "npm",
          "identifier": "@example/issue-tracker-mcp",
          "version": "1.2.0",
          "transport": {
            "type": "stdio"
          },
          "environmentVariables": [
            {
              "name": "ISSUES_URL",
              "description": "Base URL of the issue tracker",
              "isRequired": true
            },
            {
              "name": "ISSUES_TOKEN",
              "description": "API token with read and write scope",
              "isRequired": true,
              "isSecret": true
            }
          ]
        }
      ],
      "remotes": [
        {
          "type": "streamable-http",
          "url": "https://{tenant}.issues.example.com/mcp",
          "variables": {
            "tenant": {
              "description": "Your tracker workspace",
              "isRequired": true
            }
          },
          "headers": [
            {
              "name": "Authorization",
              "value": "Bearer {token}",
              "variables": {
                "token": {
                  "description": "API token with read and write scope",
                  "isRequired": true,
                  "isSecret": true
                }
              }
            }
          ]
        }
      ]
    }
  }
}
