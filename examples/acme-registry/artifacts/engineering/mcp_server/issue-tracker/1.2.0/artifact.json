      ]
    },
    {
      "path": "policy.json",
      "digest": "sha256:ac5712716dd826ace2a6a80546a49e0681d939c83b3cef7cfda1822f71edcee3",
      "size": 206,
      "media_type": "application/json",
      "urls": [
