{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kinds/semantic_model.json",
  "title": "semantic_model",
  "description": "One Apache Ossie semantic model: semantic_model.yaml or semantic_model.json, stored unchanged and validated against $defs.document. spec contains the registry slug as name and the model's description when it has one.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "MUST equal metadata.name in the envelope. The model's own name stays in the document.",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    }
  },
  "required": [
    "name"
  ],
  "additionalProperties": false,
  "x-registry-schema-version": 1,
  "x-registry-searchable": [
    "/name",
    "/description"
  ],
  "x-registry-embeddings": [
    "/description"
  ],
  "x-registry-edges": [
    {
      "rel_type": "supersedes",
      "to_kinds": [
        "semantic_model"
      ],
      "cardinality": "one",
      "direction": "outbound"
    }
  ],
  "x-registry-files": {
    "one_of": [
      [
        {
          "path": "semantic_model.yaml",
          "media_type": "application/yaml",
          "schema": {
            "$ref": "#/$defs/document"
          }
        }
      ],
      [
        {
          "path": "semantic_model.json",
          "media_type": "application/json",
          "schema": {
            "$ref": "#/$defs/document"
          }
        }
      ]
    ],
    "optional": [
      {
        "glob": "source/**"
      }
    ]
  },
  "x-registry-attachment": false,
  "x-registry-gated": false,
  "$defs": {
    "document": {
      "type": "object",
      "description": "An Apache Ossie document, which must satisfy the Ossie schema for the version it declares. A 0.1.1 document lists one model, as 0.2 holds one.",
      "properties": {
        "version": {
          "enum": [
            "0.1.1",
            "0.2.0.dev0"
          ]
        }
      },
      "required": [
        "version"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "version": {
                "const": "0.1.1"
              }
            },
            "required": [
              "version"
            ]
          },
          "then": {
            "$ref": "vendor/ossie/0.1.1/osi-schema.json",
            "properties": {
              "semantic_model": {
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "version": {
                "const": "0.2.0.dev0"
              }
            },
            "required": [
              "version"
            ]
          },
          "then": {
            "$ref": "vendor/ossie/0.2.0.dev0/ossie-schema.json"
          }
        }
      ]
    }
  }
}
